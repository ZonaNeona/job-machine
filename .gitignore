# ========================================================
# JOB-MACHINE .gitignore — Правила исключений для Git
# ========================================================

# 1. Секреты и переменные окружения (Строжайший запрет на коммит)
.env
*.env
!.env.example
.env.local
.env.*.local

# 2. Node.js & Фронтенд
node_modules/
web-app/frontend/dist/
web-app/frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# 3. Python & Виртуальные окружения
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# 4. Профили браузера Playwright (Cookies, Captcha-сессии)
scrapers/avito/browser_profile/
browser_profile/
.playwright/

# 5. Telegram Telethon Sessions (Сессионные ключи авторизации)
*.session
*.session-journal

# 6. Временные файлы БД SQLite
*.db-journal
*.db-wal
*.db-shm

# 7. Логи и системные файлы
*.log
.DS_Store
Thumbs.db
Desktop.ini

# 8. Редакторы и IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
